# Firebase web app config for project bonafarm-next.
# Copy to .env.local and fill in from: firebase apps:sdkconfig web --project bonafarm-next
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bonafarm-next.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bonafarm-next
VITE_FIREBASE_STORAGE_BUCKET=bonafarm-next.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1043932250233
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" to talk to the local emulators (npm run emulators) instead of the
# real project. Keeps development inside the Firebase no-cost limits.
VITE_USE_EMULATORS=true
